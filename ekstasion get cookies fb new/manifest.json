{
  "manifest_version": 3,
  "name": "FB Cookie Extractor String",
  "version": "1.0",
  "description": "Ekstrak cookie Facebook murni format teks spesifik ke bawah.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}