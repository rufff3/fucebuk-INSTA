{
  "manifest_version": 3,
  "name": "Instagram Cookie Extractor - SessionBox Compatible",
  "version": "2.1",
  "description": "Mengekstrak cookie sesi Instagram per-tab SessionBox secara otomatis.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}