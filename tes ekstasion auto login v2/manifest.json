{
  "manifest_version": 3,
  "name": "AUTO LOGIN FB & IG",
  "version": "2.1",
  "description": "Auto login cepat ke akun Facebook & Instagram.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "512": "icon512.png"
  },
  "permissions": ["tabs", "scripting", "browsingData", "storage", "cookies"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Auto Login FB & IG"
  }
}